# ─── Database ─────────────────────────────────────────────
# For local dev with docker-compose, this is set in docker-compose.yml.
# For Railway, use the connection string from the PostgreSQL plugin.
DATABASE_URL=postgresql://eggeats:eggeats@db:5432/eggeats

# ─── LLM ──────────────────────────────────────────────────
# Anthropic API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ─── Supadata (YouTube transcript fetching) ───────────────
# Avoids IP blocking on Railway/datacenter IPs — 100 free transcripts/month
# https://supadata.ai → Dashboard → API Keys
SUPADATA_API_KEY=sup_...

# ─── YouTube Data API v3 ───────────────────────────────────
# Google Cloud Console → Enable YouTube Data API v3 → Create API key
# https://console.cloud.google.com/
YOUTUBE_API_KEY=AIza...

# ─── Google Places API ────────────────────────────────────
# Google Cloud Console → Enable Places API → Create API key
# Used ONLY in the backend pipeline (not per page view).
# Restrict this key to server IP for security.
GOOGLE_PLACES_API_KEY=AIza...

# ─── Mapbox ──────────────────────────────────────────────
# Free tier: 50,000 map loads/month — https://account.mapbox.com/
# Create an access token at https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=pk.eyJ1...

# ─── Google OAuth 2.0 (Admin) ─────────────────────────────
# Google Cloud Console → OAuth 2.0 → Create Web Client
# Authorized redirect URIs: https://eggeats.com/auth/callback
#                           http://localhost:8000/auth/callback
GOOGLE_CLIENT_ID=....apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# ─── Admin access ─────────────────────────────────────────
# Comma-separated list of Google emails allowed to access admin
ADMIN_EMAILS=you@gmail.com,another@gmail.com

# ─── Session security ─────────────────────────────────────
# Random secret for signing session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-random-secret-key-here

# ─── App ──────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
